# Copie para api/.env e preencha. Nunca envie o .env para o GitHub.
# Conexão com o PostgreSQL (Supabase ou local). Exemplo local:
DATABASE_URL=postgresql://fluvisense:fluvisense@localhost:5432/fluvisense

# Segredo que assina os tokens do operador. Obrigatório em qualquer ambiente: com menos de
# 32 caracteres, a API não liga. Para gerar um valor aleatório:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
# Duração da sessão do operador, em minutos (480 = 8 horas).
JWT_EXPIRE_MINUTES=480

# development ou production. Em production, CORS_ORIGINS precisa ter o endereço do site;
# "*" (qualquer site) só é aceito em development.
APP_ENV=development
CORS_ORIGINS=*
